+
+/* ════════════════════════════════════════
+   PHONE POLISH — readability on small screens
+   ════════════════════════════════════════ */
+@media (max-width: 600px) {
+  /* "How it works" steps read badly in two narrow columns — stack them */
+  .timeline-wrap { grid-template-columns: 1fr; gap: 28px; }
+
+  /* Slightly larger body copy on a phone */
+  .hero-desc { font-size: 0.98rem; line-height: 1.7; }
+  .tl-desc { font-size: 0.9rem; line-height: 1.65; }
+  .mod-desc { font-size: 0.9rem; line-height: 1.65; }
+  .cap-desc { font-size: 0.9rem; line-height: 1.65; }
+  .benefit-desc { font-size: 0.88rem; line-height: 1.6; }
+  .stat-label { font-size: 0.82rem; }
+  .price-features li { font-size: 0.9rem; line-height: 1.5; }
+  .footer-col a, .footer-col p { font-size: 0.9rem; }
+
+  /* iOS zooms the page in when a focused field is under 16px */
+  input, select, textarea { font-size: 16px; }
+}
